{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["API_URL", "API_TIMEOUT", "NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"],
      "env": ["NEXT_PUBLIC_*", "EXPO_PUBLIC_*"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "type-check": {},
    "clean": { "cache": false }
  }
}
