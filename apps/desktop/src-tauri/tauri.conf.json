{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-2-schema/refs/heads/main/schemas/tauri-v2.json",
  "productName": "Fe Base",
  "version": "0.0.0",
  "identifier": "com.febase.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "windows": [
      {
        "title": "Fe Base",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  }
}
